<Layout::Resource::Tabular
    @registry="developers:event:table"
    @title={{t "developers.events.index.title"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.search}}
    @searchDisabled={{cannot "developers list event"}}
    @onReload={{this.reload}}
    @data={{@model}}
    @columns={{this.columns}}
    @selectable={{false}}
    @canSelectAll={{false}}
    @onRowClick={{this.onRowClick}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @controller={{this}}
/>
