<Layout::Section::Header @title={{@model.description}} @actionsWrapperClass="space-x-2">
    <Layout::Resource::ActionButtons @buttons={{this.actionButtons}} />
</Layout::Section::Header>

<Layout::Section::Body>
    <div class="h-screen overflow-y-scroll">
        <div class="max-w-6xl mx-auto">
            <ApiEvent::Details @apiEvent={{@model}} />
            <ApiEvent::Data @apiEvent={{@model}} />
        </div>
        <Spacer @height="200px" />
    </div>
</Layout::Section::Body>