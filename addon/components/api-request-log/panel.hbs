<div class="dev-request-detail" ...attributes>
    <div class="dev-reshead">
        <span class="dev-reshead-icon is-{{this.statusBadge}}"><FaIcon @icon="terminal" /></span>
        <div class="dev-reshead-main">
            <h1 class="dev-reshead-title">
                <span class="dev-method dev-method-{{lowercase this.log.method}}">{{this.log.method}}</span>
                <span class="dev-mono dev-reshead-path" title={{this.log.full_url}}>{{this.log.path}}</span>
                <Badge @status={{this.statusBadge}} @text={{this.statusText}} @size="xs" @hideStatusDot={{true}} @disableHumanize={{true}} />
            </h1>
            <div class="dev-reshead-sub">
                <span class={{if this.isSlow "dev-text-danger"}}>{{or this.duration "—"}}</span>
                <span>·</span>
                <span>{{this.createdAt}}</span>
                <span>·</span>
                <span>{{t "developers.logs.index.api-credential"}} {{#if this.log.api_credential_uuid}}<a href="javascript:;" {{on "click" this.requestsForKey}}>{{or (credential-name this.log.api_credential_name) (mask-key this.log.api_credential_uuid)}}</a>{{else}}—{{/if}}</span>
                {{#if this.log.ip_address}}<span>·</span><a href="javascript:;" class="dev-mono" {{on "click" this.requestsFromIp}}>{{this.log.ip_address}}</a>{{/if}}
                <span>·</span>
                <span>{{t "developers.common.version"}} <span class="dev-mono">{{n-a this.log.version}}</span></span>
                <span>·</span>
                <span>{{t "developers.common.source"}} <Badge @status="inactive" @text={{or this.log.source "api"}} @size="xxs" @hideStatusDot={{true}} @disableHumanize={{true}} /></span>
                {{#if this.log.content_type}}<span>·</span><span class="dev-mono">{{this.log.content_type}}</span>{{/if}}
                <span>·</span>
                <ClickToCopy @value={{this.log.public_id}}><span class="dev-mono">{{this.log.public_id}}</span></ClickToCopy>
            </div>
        </div>
        <div class="dev-reshead-actions">
            <Button @size="sm" @icon="terminal" @text={{t "developers.code-viewer.copy-curl"}} @onClick={{this.copyCurl}} />
            <Button @size="sm" @icon="copy" @text={{t "developers.logs.actions.copy-id"}} @onClick={{this.copyId}} />
            {{#unless @isPage}}
                <Button @size="sm" @icon="arrow-up-right-from-square" @helpText={{t "developers.common.open-full-page"}} @onClick={{this.openFullPage}} />
            {{/unless}}
        </div>
    </div>

    <div class="dev-stats dev-stats-4">
        <div class="dev-stat">
            <div class="dev-stat-label">{{t "developers.logs.panel.full-url"}}</div>
            <ClickToCopy @value={{this.log.full_url}}><div class="dev-mono dev-stat-mono">{{this.log.full_url}}</div></ClickToCopy>
        </div>
        <div class="dev-stat">
            <div class="dev-stat-label">{{t "developers.logs.panel.tab-request-body"}}</div>
            <div class="dev-stat-hint">{{or this.requestSize "0 B"}}{{#if this.log.content_type}} · {{this.log.content_type}}{{/if}}</div>
        </div>
        <div class="dev-stat">
            <div class="dev-stat-label">{{t "developers.logs.panel.tab-response-body"}}</div>
            <div class="dev-stat-hint">{{or this.responseSize "0 B"}}{{#if this.responseContentType}} · {{this.responseContentType}}{{/if}}</div>
        </div>
        <div class="dev-stat">
            <div class="dev-stat-label">{{t "developers.logs.panel.related"}}</div>
            <div class="dev-stat-hint">{{#if this.relatedResources.length}}{{#each this.relatedResources as |id|}}<span class="dev-mono">{{id}}</span> {{/each}}{{else}}—{{/if}}</div>
        </div>
    </div>

    <SectionCard @flush={{true}} class="dev-request-tabs">
        <:default>
            <TabNavigation @tabs={{this.tabs}} @activeTabId={{this.activeTab}} @onTabChange={{this.setTab}} @style="github" @size="sm" @tablistClass="dev-tabs dev-request-tablist">
                <div class="dev-request-tab-body">
                    {{#if (eq this.activeTab "query-params")}}
                        <CodeViewer @value={{this.log.query_params}} @title={{t "developers.component.api-request-log.query-params.title"}} @emptyText={{t "developers.component.api-request-log.query-params.no-parameters"}} />
                    {{else if (eq this.activeTab "request-headers")}}
                        <CodeViewer @value={{this.maskedRequestHeaders}} @title={{t "developers.component.api-request-log.request-headers.title"}} @meta={{t "developers.logs.panel.masked"}} @emptyText={{t "developers.component.api-request-log.request-headers.no-headers"}} />
                    {{else if (eq this.activeTab "response-headers")}}
                        <CodeViewer @value={{this.log.response_headers}} @title={{t "developers.logs.panel.tab-response-headers"}} @emptyText={{t "developers.logs.panel.no-response-headers"}} />
                    {{else if (eq this.activeTab "response-body")}}
                        <CodeViewer @value={{this.responseBody}} @title={{concat (t "developers.component.api-request-log.response-body.title") " · " this.statusText}} @emptyText={{t "developers.component.api-request-log.response-body.no-response-body"}} />
                    {{else}}
                        <CodeViewer @value={{this.requestBody}} @title={{t "developers.logs.panel.tab-request-body"}} @emptyText={{t "developers.component.api-request-log.request-body.no-request-body" method=this.log.method}} />
                    {{/if}}
                </div>
            </TabNavigation>
        </:default>
    </SectionCard>

    {{#if this.isError}}
        <div class="dev-request-error-grid">
            <SectionCard @title={{t "developers.logs.panel.tab-response-body"}} @flush={{true}}>
                <:actions><Badge @status={{this.statusBadge}} @text={{this.statusText}} @size="xs" @hideStatusDot={{true}} @disableHumanize={{true}} /></:actions>
                <:default><CodeViewer @value={{this.responseBody}} @title={{t "developers.logs.panel.tab-response-body"}} @emptyText={{t "developers.component.api-request-log.response-body.no-response-body"}} class="dev-code-viewer-flush" /></:default>
            </SectionCard>
            <SectionCard @title={{t "developers.logs.panel.headers"}} @flush={{true}}>
                <:actions>
                    <div class="dev-segmented dev-segmented-xs">
                        <button type="button" class="dev-segment {{if (eq this.headerSide 'request') 'is-active'}}" {{on "click" (fn this.setHeaderSide "request")}}>{{t "developers.logs.panel.request"}}</button>
                        <button type="button" class="dev-segment {{if (eq this.headerSide 'response') 'is-active'}}" {{on "click" (fn this.setHeaderSide "response")}}>{{t "developers.logs.panel.response"}}</button>
                    </div>
                </:actions>
                <:default>
                    <table class="dev-widget-table dev-headers-table">
                        <tbody>
                            {{#each this.headerRows as |row|}}
                                <tr><td class="dev-mono dev-muted">{{row.name}}</td><td class="dev-mono">{{row.value}}{{#if row.masked}} <Badge @status="inactive" @text={{t "developers.logs.panel.masked"}} @size="xxs" @hideStatusDot={{true}} @disableHumanize={{true}} />{{/if}}</td></tr>
                            {{else}}
                                <tr><td class="dev-muted" colspan="2">{{t "developers.component.api-request-log.request-headers.no-headers"}}</td></tr>
                            {{/each}}
                        </tbody>
                    </table>
                </:default>
            </SectionCard>
        </div>
    {{/if}}

    <div class="dev-curl">
        <div class="dev-codebar">
            <span>{{t "developers.logs.panel.curl-preview"}}</span>
            <div class="dev-codebar-actions"><Button @size="xs" @icon="copy" @text={{t "developers.common.copy"}} @onClick={{this.copyCurl}} /></div>
        </div>
        <pre class="dev-code-pre">{{this.curl}}</pre>
    </div>
</div>
