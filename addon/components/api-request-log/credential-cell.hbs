{{#if @row.api_credential_uuid}}
    <span class="dev-cell-text dev-identity" title={{or @value @row.api_credential_uuid}}>
        <span class="dev-identity-icon dev-identity-icon-sm is-green"><FaIcon @icon="key" @size="xs" /></span>
        <span class="dev-identity-title is-regular">{{or (credential-name @value) (mask-key @row.api_credential_uuid)}}</span>
    </span>
{{else}}
    <span class="dev-cell-text dev-muted">—</span>
{{/if}}
