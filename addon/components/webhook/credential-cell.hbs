{{#if @row.api_credential_uuid}}
    <span class="dev-cell-text dev-identity" title={{@row.api_credential_name}}>
        <span class="dev-identity-icon dev-identity-icon-sm is-green"><FaIcon @icon="key" @size="xs" /></span>
        <span class="dev-identity-title is-regular">{{or (credential-name @row.api_credential_name) (mask-key @row.api_credential_uuid)}}</span>
    </span>
{{else}}
    <span class="dev-cell-text dev-muted">{{t "developers.webhooks.index.any-credential"}}</span>
{{/if}}
