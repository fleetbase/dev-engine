<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}} as |options|>
    <div class="modal-body-container dev-modal-body">
        <Modal::Steps
            @steps={{array
                (hash label=(t "developers.api-keys.roll.step-expire") state=(if (eq options.step "form") "active" "done"))
                (hash label=(t "developers.api-keys.roll.step-reveal") state=(if (eq options.step "reveal") "active" "pending"))
            }}
            class="mb-4"
        />

        {{#if (eq options.step "reveal")}}
            <ApiKey::Reveal
                @revealed={{options.revealed}}
                @acknowledged={{options.acknowledged}}
                @onToggleAck={{options.toggleAck}}
                @warning={{t "developers.api-keys.roll.reveal-warning" expiration=options.expiration}}
            />
        {{else}}
            <div class="dev-note dev-note-info mb-4">
                <FaIcon @icon="circle-info" />
                <span>{{t "developers.api-keys.roll.explain" channel=options.dependents.channel}}</span>
            </div>

            <dl class="dev-kv is-compact mb-4">
                <dt>{{t "developers.api-keys.roll.current-key"}}</dt>
                <dd><span class="dev-tag"><span>{{options.apiKey.key}}</span></span></dd>
                <dt>{{t "developers.api-keys.index.last-used"}}</dt>
                <dd>
                    {{or (time-ago options.apiKey.last_used_at) (t "developers.common.never-used")}}
                    <Button @type="link" @size="xs" @text={{t "developers.api-keys.actions.view-requests"}} @onClick={{options.viewRequestLogs}} />
                </dd>
                <dt>{{t "developers.api-keys.roll.dependents"}}</dt>
                <dd>{{t "developers.api-keys.roll.dependents-value" count=options.dependents.webhooks.length}}</dd>
            </dl>

            <InputGroup @name={{t "developers.api-keys.roll.expire-label"}} @helpText={{t "developers.api-keys.roll.expire-help"}}>
                <div class="dev-chip-choices" role="radiogroup">
                    {{#each options.expirationChoices as |choice|}}
                        <button type="button" class="dev-chip {{if (eq options.expiration choice.value) 'is-active'}}" {{on "click" (fn options.setExpiration choice.value)}} disabled={{cannot options.formPermission}}>{{choice.label}}</button>
                    {{/each}}
                </div>
            </InputGroup>

            <div class="dev-divider"></div>

            <div class="mb-3">
                <div class="dev-label">{{t "developers.api-keys.roll.confirm-title"}}</div>
                <div class="dev-muted">{{t "developers.api-keys.roll.confirm-text" email=options.user.email}}</div>
            </div>

            <InputGroup @name={{t "developers.common.password"}}>
                <Input
                    @type="password"
                    @value={{options.password}}
                    placeholder={{t "developers.component.modals.roll-api-key-form.user-password-placeholder"}}
                    aria-label={{t "developers.component.modals.roll-api-key-form.user-password"}}
                    class="w-full form-input {{if options.error 'is-invalid'}}"
                    disabled={{cannot options.formPermission}}
                    autocomplete="current-password"
                />
                {{#if options.error}}
                    <div class="dev-error">{{options.error}}</div>
                {{/if}}
            </InputGroup>
        {{/if}}
    </div>
</Modal::Default>
