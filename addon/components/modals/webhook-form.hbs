<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}} as |options|>
    <div class="modal-body-container dev-modal-body">
        {{#if options.readOnly}}
            <div class="dev-note dev-note-warning mb-4">
                <FaIcon @icon="lock" />
                <span>{{t "developers.api-keys.edit.read-only" permission=options.formPermission}}</span>
            </div>
        {{/if}}

        <InputGroup @name={{t "developers.component.modals.webhook-form.endpoint-url"}} @required={{true}} @helpText={{t "developers.component.modals.webhook-form.endpoint-url-help-text"}}>
            <Input
                @type="url"
                @value={{options.webhook.url}}
                placeholder="https://example.com/hooks/fleetbase"
                aria-label={{t "developers.component.modals.webhook-form.endpoint-url"}}
                class="w-full form-input {{if options.urlError 'is-invalid'}}"
                disabled={{options.readOnly}}
                {{on "input" options.validateUrl}}
            />
            {{#if options.urlError}}
                <div class="dev-error">{{options.urlError}}</div>
            {{/if}}
        </InputGroup>

        <InputGroup @name={{t "developers.component.modals.webhook-form.description-label"}} @helpText={{t "developers.component.modals.webhook-form.description-help-text"}}>
            <Input
                @value={{options.webhook.description}}
                placeholder={{t "developers.component.modals.webhook-form.description-placeholder"}}
                aria-label={{t "developers.component.modals.webhook-form.description-aria-label"}}
                class="w-full form-input"
                disabled={{options.readOnly}}
            />
        </InputGroup>

        <div class="dev-form-grid">
            <InputGroup @name={{t "developers.component.modals.webhook-form.api-credential-label"}} @helpText={{t "developers.webhooks.form.credential-help"}}>
                <ModelSelect
                    @modelName="api-credential"
                    @selectedModel={{options.selectedCredential}}
                    @placeholder={{t "developers.webhooks.form.any-credential"}}
                    @triggerClass="form-select form-input"
                    @allowClear={{true}}
                    @renderInPlace={{true}}
                    @disabled={{options.readOnly}}
                    @selectedItemComponent={{component "resource/select-option" resourceType="api-credential" compact=true}}
                    @onChange={{options.setApiCredential}}
                    as |credential|
                >
                    <Resource::SelectOption @option={{credential}} @resourceType="api-credential" />
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "developers.common.version"}} @helpText={{t "developers.component.modals.webhook-form.version-help-text"}}>
                <Select
                    @options={{options.versionOptions}}
                    @value={{options.webhook.version}}
                    @placeholder={{t "developers.component.modals.webhook-form.version-message"}}
                    @onSelect={{options.setVersion}}
                    @disabled={{options.readOnly}}
                    class="w-full form-input"
                />
            </InputGroup>
        </div>

        <InputGroup @name={{t "developers.common.environment"}} @helpText={{t "developers.webhooks.form.mode-help"}}>
            <div class="dev-inline">
                <Badge @status={{if (eq options.webhook.mode "test") "warning" "success"}} @text={{if (eq options.webhook.mode "test") (t "developers.common.test") (t "developers.common.live")}} />
                <span class="dev-muted">{{t "developers.webhooks.form.mode-text"}}</span>
            </div>
        </InputGroup>

        <Webhook::EventPicker @events={{options.webhookEvents}} @selected={{options.webhook.events}} @onChange={{options.setEvents}} @disabled={{options.readOnly}} class="mb-2" />
    </div>
</Modal::Default>
