{{#if @value}}
    <span class="dev-cell-text dev-identity" title={{@value}}>
        <span class="dev-identity-icon dev-identity-icon-sm is-green"><FaIcon @icon="key" @size="xs" /></span>
        <span class="dev-identity-title is-regular">{{or (get @column.cellComponentArgs.names @value) (mask-key @value)}}</span>
    </span>
{{else}}
    <span class="dev-cell-text dev-muted">—</span>
{{/if}}
